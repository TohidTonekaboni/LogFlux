FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o /out/ingestion ./cmd/ingestion

FROM alpine:3.20
RUN adduser -D -u 10001 logflux
COPY --from=builder /out/ingestion /usr/local/bin/ingestion
USER logflux
EXPOSE 9000 2112
ENTRYPOINT ["/usr/local/bin/ingestion"]
