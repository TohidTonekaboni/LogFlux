FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -o /out/consumer ./cmd/consumer

FROM alpine:3.20
RUN adduser -D -u 10001 logflux
COPY --from=builder /out/consumer /usr/local/bin/consumer
USER logflux
EXPOSE 2113
ENTRYPOINT ["/usr/local/bin/consumer"]
