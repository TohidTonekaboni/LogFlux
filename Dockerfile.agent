FROM golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/agent ./cmd/agent

FROM alpine:3.20
RUN adduser -D -u 10001 logflux
COPY --from=builder /out/agent /usr/local/bin/agent
USER logflux
ENTRYPOINT ["/usr/local/bin/agent"]
